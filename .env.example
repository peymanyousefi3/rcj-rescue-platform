# Docker environment template. Supply fresh values; never commit .env.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
PROXY_SHARED_SECRET=
# Names only. Configure real values using the server secret manager.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
PUBLIC_ORIGIN=
DATABASE_URL=
REQUIRE_STAFF_OTP=1
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Google Drive is optional. Use a dedicated restricted folder, not a shared team folder.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_PRIVATE_FOLDER_ID=
SOURCE_WORKBOOK_ID=
# Use shared_link only for a workbook already shared for link access; default uses Google credentials.
SOURCE_WORKBOOK_ACCESS=google
# Scan uploaded files with a ClamAV daemon over the private Docker network.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
TRUST_PROXY_HTTPS=0
TRUST_PROXY_CLIENT_IP=0
DB_POOL_MAX_SIZE=4
UPLOAD_MAX_FILE_BYTES=1073741824
UPLOAD_MAX_BATCH_BYTES=2147483648
UPLOAD_MAX_FILES=5000
UPLOAD_TEAM_MAX_BYTES=21474836480
UPLOAD_MIN_FREE_BYTES=536870912
RECORDING_MAX_EXTRACTED_BYTES=536870912
VALIDATION_MAX_BYTES=67108864
MAIL_MAX_PENDING=10000
IMAGE_MAX_PIXELS=16000000
