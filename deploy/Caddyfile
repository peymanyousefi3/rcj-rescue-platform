{
  servers {
    timeouts {
      read_header 10s
      read_body 30m
      idle 2m
    }
    max_header_size 32KB
  }
}
{$PUBLIC_HOST} {
  encode zstd gzip
  request_body {
    max_size {$UPLOAD_MAX_BATCH_BYTES:2147483648}
  }
  @sensitive path /.env* /.git/* /private/* /var/* /config/*
  respond @sensitive 404
  reverse_proxy app:8000 {
    header_up X-ASR-Client-IP {remote_host}
    header_up X-ASR-Proxy-Token {$PROXY_SHARED_SECRET}
    header_up X-Forwarded-Proto https
    health_uri /ready/
    health_headers {
      Host {$PUBLIC_HOST}
      X-Forwarded-Proto https
    }
    health_interval 15s
    health_timeout 5s
    transport http {
      dial_timeout 5s
      response_header_timeout 180s
    }
  }
}
